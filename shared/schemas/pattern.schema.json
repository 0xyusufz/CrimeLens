{
  "$defs": {
    "PatternType": {
      "enum": [
        "CIRCULAR_TRANSACTION",
        "RAPID_TRANSFER_CHAIN",
        "LOCATION_TIME_OVERLAP"
      ],
      "title": "PatternType",
      "type": "string"
    },
    "RelationshipStatus": {
      "enum": [
        "CONFIRMED",
        "INFERRED",
        "PREDICTED"
      ],
      "title": "RelationshipStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Pattern JSON from Person B. Not a dedicated Pattern table.\n\nBackend persists validated pattern results as intelligence/lead outputs\n(case insights). severity \u2260 status. Status is never coerced.",
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/PatternType"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/RelationshipStatus"
    },
    "entities": {
      "description": "ML grouping keys in this JSON; backend maps to canonical UUIDs before graph write",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Entities",
      "type": "array"
    },
    "explanation": {
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "id",
    "type",
    "severity",
    "status",
    "entities",
    "explanation",
    "evidence_ids"
  ],
  "title": "Pattern",
  "type": "object"
}
