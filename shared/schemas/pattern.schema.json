{
  "$defs": {
    "PatternStatus": {
      "description": "Lifecycle of a detected pattern. Distinct from severity.",
      "enum": [
        "DETECTED"
      ],
      "title": "PatternStatus",
      "type": "string"
    },
    "PatternType": {
      "enum": [
        "CIRCULAR_TRANSACTION",
        "RAPID_TRANSFER_CHAIN",
        "LOCATION_TIME_OVERLAP"
      ],
      "title": "PatternType",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Detected pattern. severity \u2260 status.",
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/PatternType"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/PatternStatus",
      "default": "DETECTED"
    },
    "entities": {
      "description": "Proposed/canonical entity ids",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Entities",
      "type": "array"
    },
    "explanation": {
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "id",
    "type",
    "severity",
    "entities",
    "explanation",
    "evidence_ids"
  ],
  "title": "Pattern",
  "type": "object"
}
