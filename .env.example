# PostgreSQL (source of truth)
# CrimeLens Docker maps this to host 5433 so native PostgreSQL on 5432 stays untouched.
POSTGRES_USER=crimelens
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crimelens
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Neo4j (derived graph layer)
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# DEVELOPMENT ONLY — POST /api/cases uses this user as created_by until JWT exists.
# This is not authentication. Do not send creator identity from the client.
DEV_CASE_CREATOR_EMAIL=dev-creator@crimelens.local

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT (placeholder only — auth not implemented yet)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
