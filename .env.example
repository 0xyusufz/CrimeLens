# PostgreSQL (source of truth)
# CrimeLens Docker maps this to host 5433 so native PostgreSQL on 5432 stays untouched.
POSTGRES_USER=crimelens
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crimelens
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Neo4j (derived graph layer)
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# DEVELOPMENT ONLY — POST /api/cases uses this user as created_by until JWT exists.
# The same placeholder is used for documents.uploaded_by. This is not authentication.
DEV_CASE_CREATOR_EMAIL=dev-creator@crimelens.local

# Local evidence files (server filename = document UUID, never the original name)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT authentication (local default only — set a strong secret outside development)
JWT_SECRET=crimelens-dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# AI Configuration (Optional)
# Set GEMINI_API_KEY to enable live Gemini inference.
# Leave blank to run the deterministic/mock pipeline (safe default; no network needed).
# AI_PROVIDER can be left blank — it is auto-detected from GEMINI_API_KEY.
# GEMINI_MODEL defaults to gemini-1.5-flash when not set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_PROVIDER=gemini
